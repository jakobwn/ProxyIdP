{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ProxyIdP": {
    "Issuer": "http://localhost:5000",
    "Audience": "api://AzureADTokenExchange"
  },
  "AzureAd": {
    "TenantId": "<entra-tenant-id>",
    "Audience": "<local-api-app-client-id>",
    "AllowedClientIds": [ "<example-plugin-app-registration-client-id>", "<resolver-app-registration-client-id>" ]
  },
  "LocalApi": {
    "DomainMappings": {
      "lego.com": "workforce",
      "consultant.lego.com": "workforce"
    },
    "DefaultIdpId": "customers"
  }
}
