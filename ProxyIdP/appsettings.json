{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosting": { "UseHttpsRedirection": true },
  "ForwardedHeaders": { "Enabled": false },
  "ConnectionStrings": { "Default": "Data Source=proxyidp.db" },
  "Proxy": {
    "Issuer": "https://localhost:7103",
    "AuthorizationCodeLifetimeSeconds": 300,
    "PendingAuthorizationLifetimeMinutes": 10,
    "TokenLifetimeMinutes": 30
  },
  "Ui": {
    "StylePath": "style",
    "CustomUi": { "Enabled": false, "Path": "customui" }
  },
  "SigningKeys": {
    "KeyLifetimeDays": 30,
    "RotationIntervalDays": 14,
    "MinimumValidKeys": 2,
    "ExpiredKeyGraceDays": 1
  },
  "IdpResolver": {
    "Endpoint": "",
    "Method": "POST",
    "ApiKey": "",
    "ApiKeyHeader": "X-Api-Key",
    "TimeoutSeconds": 3,
    "EmailParameter": "email",
    "Authentication": {
      "Mode": "",
      "TokenEndpoint": "",
      "ClientId": "",
      "Scope": "",
      "ClientSecret": "",
      "Subject": "",
      "Audience": "api://AzureADTokenExchange",
      "AssertionLifetimeSeconds": 300,
      "AssertionFilePath": ""
    }
  },
  "Plugins": {
    "Enabled": true,
    "Path": "plugins",
    "Types": []
  },
  "Clients": {},
  "UpstreamIdps": {}
}
