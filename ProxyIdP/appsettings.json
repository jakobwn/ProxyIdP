{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosting": { "UseHttpsRedirection": true },
  "ForwardedHeaders": { "Enabled": false },
  "ConnectionStrings": { "Default": "Data Source=proxyidp.db" },
