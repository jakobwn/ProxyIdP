{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdpResolver": {
    "Endpoint": "http://localhost:5100/resolve",
    "Method": "POST",
    "Authentication": {
      "Mode": "FederatedCredential",
      "TokenEndpoint": "https://login.microsoftonline.com/<entra-tenant-id>/oauth2/v2.0/token",
      "ClientId": "<resolver-app-registration-client-id>",
      "Scope": "api://<local-api-app-id>/.default",
      "Subject": "proxyidp-resolver"
    }
  },
  "Plugins": {
    "Enabled": true,
    "Path": "plugins",
    "Types": [ "ProxyIdP.ExamplePlugin.ExamplePlugin, ProxyIdP.ExamplePlugin" ]
  },
  "Clients": {
    "dev-client": {
      "RedirectUris": [ "https://localhost:5001/signin-oidc", "https://oauth.pstmn.io/v1/callback" ],
      "PostLogoutRedirectUris": [ "https://localhost:5001/signout-callback-oidc" ]
    }
  },
  "UpstreamIdps": {
    "workforce": {
      "Type": "EntraWorkforce",
      "DisplayName": "LEGO (Entra)",
      "SortOrder": 10,
      "Enabled": true,
      "IsDefault": false,
      "TenantId": "<entra-workforce-tenant-id>",
      "ClientId": "<entra-workforce-client-id>",
      "EmailDomains": [ "lego.com", "consultant.lego.com" ],
      "UsePkce": true
    },
    "customers": {
      "Type": "EntraExternalId",
      "DisplayName": "Customers (Entra External ID)",
      "SortOrder": 20,
      "Enabled": true,
      "IsDefault": true,
      "TenantSubdomain": "legogroupextdev",
      "TenantId": "<entra-external-id-tenant-id>",
      "ClientId": "<entra-external-id-client-id>",
      "EmailDomains": null,
      "UsePkce": true
    },
    "OIDC-IdP": {
      "Type": "GenericOidc",
      "DisplayName": "Generic Partner (OIDC)",
      "SortOrder": 30,
      "Enabled": false,
      "IsDefault": false,
      "Authority": "https://idp.partner.example",
      "ClientId": "partner-client",
      "EmailDomains": [ "partner.example" ],
      "UsePkce": true
    }
  }
}
